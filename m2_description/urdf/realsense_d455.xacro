<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="d455_camera" params="parent:=Lidar_1_link">

    <!-- RealSense D455 Camera Mounting Joint and Link -->
    <joint name="Camera_Joint" type="fixed">
      <origin rpy="0 0 0" xyz="0.026765 0 -0.073361"/>
      <parent link="${parent}"/>
      <child link="Camera_Link"/>
    </joint>

    <link name="Camera_Link">
      <inertial>
        <origin rpy="0 0 0" xyz="0.0101390855813485 3.5095208870406e-06 -0.00271488784588553"/>
        <mass value="0.106"/>
        <inertia ixx="0.000141" ixy="0" ixz="0"
                 iyy="0.000014" iyz="0" izz="0.000140"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://m2_description/meshes/Camera_Link.STL"/>
        </geometry>
        <material name="svan_grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://m2_description/meshes/Camera_Link.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Standard ROS REP-103 Optical Frame -->
    <joint name="d455_optical_joint" type="fixed">
      <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
      <parent link="Camera_Link"/>
      <child link="d455_optical_frame"/>
    </joint>
    <link name="d455_optical_frame"/>

    <!-- Gazebo Sim RGBD Camera sensor plugin -->
    <gazebo reference="Camera_Link">
      <sensor name="d455_rgbd_camera" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov> <!-- 87 deg D455 HFOV -->
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>d455</topic>
        <gz_frame_id>Camera_Link</gz_frame_id>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
