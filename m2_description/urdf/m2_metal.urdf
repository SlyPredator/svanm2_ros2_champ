  <!-- ==================== GAZEBO SIM PLUGINS ==================== -->
  <!-- ROS 2 Control Plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg robot_controllers)</parameters>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

  <!-- Ground-truth Odometry Plugin -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <dimensions>3</dimensions>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom/ground_truth</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- IMU Plugin on imu_link -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Base link physics -->
  <gazebo reference="base">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Feet Contact Sensors and Joint Preservation -->
  <!-- FL Foot -->
  <gazebo reference="FL_foot">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>10000.0</kp>
    <kd>1.0</kd>
    <sensor name="lf_foot_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <contact>
        <collision>FL_foot_collision</collision>
        <topic>/lf_foot_contacts</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="FL_foot_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- FR Foot -->
  <gazebo reference="FR_foot">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>10000.0</kp>
    <kd>1.0</kd>
    <sensor name="rf_foot_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <contact>
        <collision>FR_foot_collision</collision>
        <topic>/rf_foot_contacts</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="FR_foot_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- RL Foot -->
  <gazebo reference="RL_foot">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>10000.0</kp>
    <kd>1.0</kd>
    <sensor name="lh_foot_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <contact>
        <collision>RL_foot_collision</collision>
        <topic>/lh_foot_contacts</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="RL_foot_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- RR Foot -->
  <gazebo reference="RR_foot">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>10000.0</kp>
    <kd>1.0</kd>
    <sensor name="rh_foot_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <contact>
        <collision>RR_foot_collision</collision>
        <topic>/rh_foot_contacts</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="RR_foot_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- ==================== ROS 2 CONTROL HARDWARE INTERFACE ==================== -->
  <ros2_control name="m2_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- FL Leg Joints -->
    <joint name="FL_hip_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- FR Leg Joints -->
    <joint name="FR_hip_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_thigh_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_calf_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- RL Leg Joints -->
    <joint name="RL_hip_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- RR Leg Joints -->
    <joint name="RR_hip_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_thigh_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_calf_joint">
      <command_interface name="$(arg command_interface)"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>