<?xml version="1.0" encoding="utf-8"?>
<robot name="m2_metal" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_controllers" default="$(find m2_sim)/config/ros_control/ros_control.yaml"/>
  <xacro:arg name="command_interface" default="effort"/>

  <!-- Materials -->
  <material name="svan_black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="svan_blue">
    <color rgba="0.156 0.55 0.96 1.0"/>
  </material>
  <material name="svan_green">
    <color rgba="0.024 0.251 0.169 1.0"/>
  </material>
  <material name="svan_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Root base_link (REP-120 standard) -->
  <link name="base_link"/>
  <joint name="base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base link -->
  <link name="base">
    <inertial>
      <origin xyz="0.058346 -0.002972 0.001919" rpy="0 0 0"/>
      <mass value="5.18596663"/>
      <inertia ixx="0.02220107" ixy="-0.00019966" ixz="-0.00048929" iyy="0.05026338" iyz="-1.27e-05" izz="0.06413613"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://m2_description/meshes/torso.STL"/>
      </geometry>
      <material name="svan_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.20 0.114"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU link -->
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== FRONT LEFT (FL) LEG ==================== -->
  <joint name="FL_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="FL_hip"/>
    <origin xyz="0.147 0.06 0.00025" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-4.8" upper="4.9" effort="12" velocity="30"/>
  </joint>
  <link name="FL_hip">
    <inertial>
      <origin xyz="0.00918208 -0.00133606 -0.00430117" rpy="0 0 0"/>
      <mass value="1.127"/>
      <inertia ixx="0.0026019" ixy="0.0001226" ixz="0" iyy="0.0009202" iyz="0" izz="0.0026365"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://m2_description/meshes/FL_hip.STL"/>
      </geometry>
      <material name="svan_grey"/>
    </visual>
    <collision>
      <origin xyz="0.04 0.08 0.0" rpy="1.57 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_thigh_joint" type="revolute">
    <parent link="FL_hip"/>
    <child link="FL_thigh"/>
    <origin xyz="0.043751 0.0811 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-4.04" upper="4.188" effort="12" velocity="30"/>
  </joint>
  <link name="FL_thigh">
    <inertial>
      <origin xyz="0.0 0.00262472 -0.06933846" rpy="0 0 0"/>
      <mass value="0.15396568"/>
      <inertia ixx="0.00075104" ixy="0.0" ixz="0.0" iyy="0.00076" iyz="2.9e-05" izz="4.7e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://m2_description/meshes/FL_thigh.STL"/>
      </geometry>
      <material name="svan_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 -0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.0245 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_calf_joint" type="revolute">
    <parent link="FL_thigh"/>
    <child link="FL_calf"/>
    <origin xyz="0.0 0.0 -0.1915" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-4.69" upper="4.91" effort="24" velocity="15"/>
  </joint>
  <link name="FL_calf">
    <inertial>
      <origin xyz="-0.00106 0.0 -0.12046" rpy="0 0 0"/>
      <mass value="0.124482"/>
      <inertia ixx="0.0005021" ixy="0.0" ixz="-1.27e-05" iyy="0.000517" iyz="0" izz="2.02e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://m2_description/meshes/FL_calf.STL"/>
      </geometry>
      <material name="svan_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.01 0.0 -0.04" rpy="0 0.2 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.015"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0 0.0 -0.105" rpy="0 -0.24 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.012"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_foot_joint" type="fixed" dont_collapse="true">
    <parent link="FL_calf"/>
    <child link="FL_foot"/>
    <origin xyz="-0.00351 0.0 -0.1901" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="0" upper="0" effort="1000" velocity="0"/>
  </joint>
  <link name="FL_foot">
    <inertial>
      <origin xyz="-0.0025566 0.00017773 -0.00416818" rpy="0 0 0"/>
      <mass value="0.02330447"/>
      <inertia ixx="2.62e-06" ixy="0" ixz="3.7e-07" iyy="2.62e-06" iyz="0" izz="3e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://m2_description/meshes/FL_foot.STL"/>
      </geometry>
      <material name="svan_black"/>
    </visual>
    <collision name="FL_foot_collision">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>
  </link>

  <link name="FL_foot_site"/>
  <joint name="FL_foot_site_joint" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="-0.0 0 -0.016"/>
    <parent link="FL_foot"/>
    <child link="FL_foot_site"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="0" upper="0" velocity="0"/>
  </joint>

  <!-- ==================== FRONT RIGHT (FR) LEG ==================== -->
  <joint name="FR_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="FR_hip"/>
    <origin xyz="0.147 -0.06 0.00025" rpy="0 0 0"/>
